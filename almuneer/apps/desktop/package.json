{
  "name": "@almuneer/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {"start": "electron .", "build:win": "electron-builder --win nsis"},
  "devDependencies": {"electron": "^38.0.0", "electron-builder": "^26.0.12"},
  "build": {
    "appId": "com.almuneer.desktop",
    "productName": "المُنير",
    "files": ["main.mjs", "../web/dist/**/*"],
    "win": {"target": "nsis"},
    "artifactName": "Almuneer-Setup-${version}-${arch}.${ext}",
    "nsis": {"oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "createStartMenuShortcut": true, "deleteAppDataOnUninstall": false}
  }
}
